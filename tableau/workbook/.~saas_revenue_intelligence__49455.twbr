  <dashboards>
    <dashboard name='Customer risk'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Customer risk</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Risk threshold' datatype='real' default-format='p0%' name='[threshold_param]' param-domain-type='list' role='measure' type='quantitative' value='0.04'>
          <calculation class='tableau' formula='0.04' />
          <members>
            <member value='0.01' />
            <member value='0.02' />
            <member value='0.03' />
            <member value='0.04' />
            <member value='0.05' />
